# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# MongoDB connection string (Atlas or any MongoDB server).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?appName=bloom

# Database name. Defaults to "bloom-diary" when left out.
MONGODB_DB=bloom-diary

# Owner unlock pattern: dots 1-9 (tap order), separated by dashes, at least four dots.
# Pick your own, for example four or more different digits from 1 to 9.
OWNER_PATTERN=<dot-1>-<dot-2>-<dot-3>-<dot-4>
